# BI Hub App - Local Development Environment Variables
# Copy this file to .env and fill in your values:
#   cp env.template .env

# ===========================================
# AUTHENTICATION (for local dev, use PAT mode)
# ===========================================
ENABLE_HEADER_AUTH=false
ENABLE_PASSWORD_AUTH=true

# Your Databricks Personal Access Token
DATABRICKS_TOKEN=dapi...

# ===========================================
# DATABRICKS WORKSPACE
# ===========================================
# Your Databricks workspace URL (without trailing slash)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Model Serving Endpoint name
SERVING_ENDPOINT=mas-d8f57d8b-endpoint

# ===========================================
# LAKEBASE (PostgreSQL) - Optional
# ===========================================
# Database instance name
DATABASE_INSTANCE=cx-live-demo-no-delete

# Connection details (get these from Lakebase UI or CLI)
# PGHOST=your-lakebase-host.cloud.databricks.com
# PGPORT=5432
# PGUSER=your-username
# PGDATABASE=your-database
# PGSSLMODE=require
